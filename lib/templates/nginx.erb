#### Receive forwarded TCP traffic checked by SSL_PREREAD and
#### forward to SINATRA as http (if domain matches wallet.vaizer.net)
server {
   listen       127.0.0.1:8443 ssl http2 proxy_protocol;
   server_name  wallet.vaizer.net;
   ssl_certificate <%="#{@env_values['ssl']}/fullchain.pem;"%>
   ssl_certificate_key <%="#{@env_values['ssl']}/privkey.pem;"%>
   set_real_ip_from  127.0.0.1;
   real_ip_header    proxy_protocol;
   location / {
        proxy_pass http://localhost:8080;
    }
}



#### Receive forwarded TCP traffic checked by SSL_PREREAD and
#### return 444 (Drop connection)
server {
    listen 127.0.0.1:8443 ssl http2 proxy_protocol default_server;
    server_name _; # Catch-all server_name
    ssl_certificate /etc/nginx/ssl/nginx-selfsigned.crt; # A fallback certificate
    ssl_certificate_key /etc/nginx/ssl/nginx-selfsigned.key; # A fallback key
    return 444; # Closes the connection immediately
}